{
  "manifest_version": 3,
  "name": "XFollower · 粉丝跟进",
  "version": "3.11.1",
  "description": "本地管理 X 粉丝画像与创作任务，支持 Grok、Grok Hook、本地 Grok Bot、任务恢复及配图。",
  "permissions": [
    "scripting",
    "storage",
    "alarms",
    "notifications",
    "tabs",
    "windows",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://grok.com/*"
  ],
  "optional_host_permissions": [
    "http://127.0.0.1/*",
    "https://api.cloudflare.com/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "bridge.js",
        "tweet-comment-button.js",
        "profile-followback-badge.js"
      ],
      "css": [
        "tweet-comment-button.css",
        "profile-followback-badge.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "transaction-id.bundle.js",
        "net-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "icons": {
    "128": "icon128.png"
  },
  "action": {
    "default_title": "打开 XFollower 粉丝跟进"
  }
}
