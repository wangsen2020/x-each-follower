{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "4.16.0",
  "description": "__MSG_extDesc__",
  "permissions": [
    "scripting",
    "storage",
    "alarms",
    "notifications",
    "tabs",
    "windows",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://grok.com/*"
  ],
  "optional_host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://api.cloudflare.com/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "exception-capture.js",
        "i18n-content.js",
        "bridge.js",
        "tweet-comment-button.js",
        "profile-followback-badge.js"
      ],
      "css": [
        "tweet-comment-button.css",
        "profile-followback-badge.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "transaction-id.bundle.js",
        "net-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "icons": {
    "128": "icon128.png"
  },
  "action": {
    "default_title": "__MSG_extAction__"
  },
  "default_locale": "en"
}
