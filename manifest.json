{
  "manifest_version": 3,
  "name": "FollowBack Radar · 回关雷达",
  "version": "0.8.3",
  "description": "本地监测 X followers、non-followers 和 mutuals，管理 follow-back 队列并检查粉丝质量。",
  "permissions": ["scripting", "storage", "alarms", "notifications", "tabs", "windows", "clipboardWrite"],
  "host_permissions": ["https://x.com/*", "https://twitter.com/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {"matches":["https://x.com/*","https://twitter.com/*"],"js":["bridge.js"],"run_at":"document_start"},
    {"matches":["https://x.com/*","https://twitter.com/*"],"js":["net-hook.js"],"run_at":"document_start","world":"MAIN"}
  ],
  "icons": {"128": "icon128.png"},
  "action": {"default_title": "打开 XFollower 回关雷达"}
}




