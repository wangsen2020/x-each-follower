{
  "manifest_version": 3,
  "name": "X 互关线索筛选",
  "version": "0.1.0",
  "description": "逐个访问 X 用户资料，结合互关描述、粉丝数和关注数筛选可复核的互关线索。",
  "permissions": ["scripting", "storage", "alarms", "notifications", "tabs"],
  "host_permissions": ["https://x.com/*", "https://twitter.com/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "打开 X 互关线索筛选"}
}
